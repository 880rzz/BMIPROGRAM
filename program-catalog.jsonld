      "name": "Borsófőzde | Schwedenplatz",
      "url": "https://www.magyariskola.at/event-details/borsofozde-2026",
      "description": "Zenés-mozgásos baba–mama közeg mondókákkal, énekkel és közösségi élménnyel. Kisgyermekkel olyan rendszeres magyar nyelvű közeget keresel, ahol a mondókák, zene és mozgás természetesen része a közös időnek. Életkornak megfelelő magyar nyelvi élmények, közös ritmus, mozgás és első közösségi kapcsolódások.",
      "provider": {
        "@id": "https://www.magyariskola.at/#org"
      },
      "audience": {
        "@type": "EducationalAudience",
        "audienceType": "0–3 év"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "@id": "https://programvalaszto.magyariskola.at/#instance-borsofozde",
        "name": "Borsófőzde | Schwedenplatz – 2026/27",
        "description": "Minden hétfőn 10:00 órától · Schwedenplatz 2., 1010 Wien – 9-es terem · 40 € / hó",
        "courseMode": "onsite",
        "location": {
          "@type": "Place",
          "name": "Schwedenplatz 2., 1010 Wien – 9-es terem"
        },
        "instructor": {
          "@type": "Person",
          "name": "Horányi Bori"
        }
      },
      "keywords": "nyelv, mozgas"
    },
